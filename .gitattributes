# Normalise all text files to LF in the repository and working tree.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Lock files: never merge line by line.
uv.lock -diff linguist-generated=true

# Binary assets
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.avif   binary
*.ico    binary
*.pdf    binary
*.parquet binary
*.feather binary
*.arrow  binary
*.duckdb binary
*.pkl    binary
*.joblib binary
*.npy    binary
*.npz    binary
*.pt     binary
*.ckpt   binary
*.zip    binary
*.gz     binary
*.xlsx   binary
*.ots    binary
